__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Experiment outputs. Anchored with a leading slash so these match only at the
# repo root -- an unanchored "results/" also matched docs/results/, which
# silently dropped committed run evidence.
/runs/
/results/
/outputs/
/wandb/
*.zip
*.pt
*.pth
*.npz
*.csv
!tests/**/*.csv

# Evidence backing the write-ups in docs/runs/ IS committed: the diagnostics
# figure, the metric history, and the evaluation result for each run.
!docs/runs/assets/
!docs/runs/assets/**

# Anything committed for reading lives under docs/. A top-level figures/ is
# scratch for ad-hoc plotting and is never tracked.
/figures/

# The source paper is the authors' copyrighted work; not redistributed here.
*.pdf
!docs/*.pdf

.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
